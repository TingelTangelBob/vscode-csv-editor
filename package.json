{
  "name": "csv-simple-editor",
  "displayName": "CSV Simple Editor",
  "description": "View and edit CSV and TSV files as tables in VS Code. Detect delimiters, sort and filter columns, and import rows with validation.",
  "version": "1.4.12",
  "publisher": "tingeltangelbob",
  "repository": {
    "type": "git",
    "url": "https://github.com/TingelTangelBob/vscode-csv-editor.git"
  },
  "homepage": "https://github.com/TingelTangelBob/vscode-csv-editor#readme",
  "bugs": {
    "url": "https://github.com/TingelTangelBob/vscode-csv-editor/issues"
  },
  "icon": "./media/extension-icon.png",
  "keywords": [
    "csv",
    "csv editor",
    "csv viewer",
    "csv file editor",
    "csv table editor",
    "csv table",
    "tsv",
    "tsv editor",
    "delimited text editor",
    "table editor",
    "spreadsheet editor",
    "data editor",
    "data viewer",
    "csv preview",
    "edit csv",
    "filter csv",
    "sort csv",
    "delimiter detection",
    "tabular data",
    "comma separated values",
    "semicolon separated values",
    "tab separated values"
  ],
  "scripts": {
    "test": "node --test",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File ./package-vsix.ps1"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Data Science",
    "Visualization"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:tingeltangelbob.csv-simple-editor.open",
    "onCommand:tingeltangelbob.csv-simple-editor.openAsText",
    "onCustomEditor:tingeltangelbob.csv-simple-editor.csvGrid",
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "CSV Simple Editor",
      "properties": {
        "csvSimpleEditor.openByDefault": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Open CSV and TSV files in CSV Simple Editor by default. Turn this off to use the standard text editor."
        }
      }
    },
    "commands": [
      {
        "command": "tingeltangelbob.csv-simple-editor.open",
        "title": "Open CSV Table",
        "icon": {
          "light": "./media/csv-table-light.svg",
          "dark": "./media/csv-table-dark.svg"
        }
      },
      {
        "command": "tingeltangelbob.csv-simple-editor.openAsText",
        "title": "Open as Text",
        "icon": "$(file-code)"
      }
    ],
    "customEditors": [
      {
        "viewType": "tingeltangelbob.csv-simple-editor.csvGrid",
        "displayName": "CSV Simple Editor",
        "selector": [
          { "filenamePattern": "*.csv" },
          { "filenamePattern": "*.CSV" },
          { "filenamePattern": "*.tsv" },
          { "filenamePattern": "*.TSV" }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tingeltangelbob.csv-simple-editor.open",
          "when": "(resourceExtname == .csv || resourceExtname == .CSV || resourceExtname == .tsv || resourceExtname == .TSV) && activeCustomEditorId != tingeltangelbob.csv-simple-editor.csvGrid",
          "group": "navigation@1"
        },
        {
          "command": "tingeltangelbob.csv-simple-editor.openAsText",
          "when": "activeCustomEditorId == tingeltangelbob.csv-simple-editor.csvGrid",
          "group": "navigation@1"
        }
      ]
    }
  }
}
